{
  "name": "opencode-tuicr-plugin",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin that launches tuicr reviews from Herdr.",
  "type": "module",
  "main": "./dist/opencode-tuicr-plugin.js",
  "types": "./dist/opencode-tuicr-plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/opencode-tuicr-plugin.d.ts",
      "import": "./dist/opencode-tuicr-plugin.js"
    }
  },
  "files": [
    "dist",
    "herdr",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "verify": "npm run typecheck && npm test && npm run pack:check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tuicr",
    "code-review",
    "herdr",
    "tui"
  ],
  "author": "dartyuhov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dartyuhov/opencode-tuicr-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/dartyuhov/opencode-tuicr-plugin/issues"
  },
  "homepage": "https://github.com/dartyuhov/opencode-tuicr-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.4.10",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
